# Copy this file to course.yaml only in a courses/<slug> branch.
# This template is deliberately a non-deployable draft with no learning content.
schemaVersion: 1
slug: replace-with-course-slug
title: Replace with the course title
description: Replace with a short course description.
lifecycleStatus: draft
availability: inDevelopment
sortOrder: 1
materials:
  # Image attachments are derived from Obsidian/Markdown embeds during CI.
  # Authors do not need to add per-material assets entries.
  # Lectures may independently declare markdown under lectures/ and concise
  # briefMarkdown under lecture-notes/. Omitted paths stay dormant and are not
  # published; declaring a path enables strict validation and publication.
  # Any material may declare ordered files:
  # attachments: [{ key: slides, title: Slides, file: attachments/slides.pptx, sortOrder: 10 }]
  lectures: []
  seminars: []
  homeworks: []
